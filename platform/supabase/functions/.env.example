# Copy to .env for local runs; set the same names as secrets when deploying.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to deployed functions automatically.

# Malware scanning (required: without it every release goes to a person)
VIRUSTOTAL_API_KEY=

# Optional listing check; leave empty to skip that stage
ANTHROPIC_API_KEY=
LISTING_MODEL=claude-sonnet-5-5

# Safe default is true: nothing is auto-approved until a sandbox provider is plugged in.
# Set to false only when you have decided that is acceptable.
REQUIRE_SANDBOX=true

# Share of clean releases from trusted developers that a person checks anyway
SPOT_RATE=0.05

# Websites allowed to call scan-release from a browser (comma separated)
ALLOWED_ORIGINS=https://noodletechnology.com

# Files larger than this (bytes) get hash-only checks and go to a person
MAX_AUTO_BYTES=67108864
